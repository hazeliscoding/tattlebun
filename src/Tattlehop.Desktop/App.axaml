<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Tattlehop.Desktop.App"
             Name="Tattlehop">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Tattlehop/Themes/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <!-- The Windows tray menu is drawn with Avalonia controls, so it needs a theme even with no window. -->
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>

  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="avares://Tattlehop/Assets/tattlehop.ico" ToolTipText="Tattlehop">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Quit Tattlehop" Click="OnQuit" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
